#!/usr/bin/env python3
"""kb-note: the generic name of vault-note (KB write-back); same arguments, output and exit codes.

Location: pact-plugin/bin/kb-note. It replaces itself with vault-note beside it, so
there is one implementation and `kb-note --help` is `vault-note --help`.
"""
import os
import sys
from pathlib import Path

TARGET = Path(__file__).resolve().parent / "vault-note"

if __name__ == "__main__":
    os.execv(sys.executable, [sys.executable, str(TARGET), *sys.argv[1:]])
