#!/usr/bin/env bash
# pact — PACT-loaded Claude Code session launcher.
#
# Wraps `claude --agent repacted:pact-orchestrator "$@"` so that PACT's
# orchestrator persona is loaded automatically. Pass through any
# additional flags claude accepts (e.g., --resume, --plugin-dir,
# --print, --debug) and they are forwarded unchanged.
#
# Installation (manual symlink — there is no install automation):
#   ln -s "<rePACT checkout>/repacted/pact-plugin/bin/pact" \
#         "$HOME/.local/bin/pact"
#
# Or any other directory on your PATH (~/bin, /usr/local/bin, etc.).
# After symlinking, `pact` invokes a PACT-loaded session from anywhere.
#
# Install automation, a manpage, and package-manager integration remain
# unbuilt and unscheduled. This script is the supported path, not a
# placeholder for one.

set -e
# Inside a repact session (REPACTED_LAUNCH is set by bin/repact) this launcher would start a
# session without repact's memory swap, so it refuses there, like repacted-memdir --confirm-live.
if [ -n "${REPACTED_LAUNCH:-}" ]; then
  echo "pact: REFUSED: REPACTED_LAUNCH is set, so this runs inside a repact session; start pact from a plain terminal" >&2
  exit 2
fi
exec claude --agent repacted:pact-orchestrator "$@"
