#!/usr/bin/env python3
"""handoff-evidence: replay the HANDOFF run-evidence check.

Location: pact-plugin/bin/handoff-evidence (work unit unit 11; documented by
repacted:pact-lead-playbook). Runs the same module the hooks run (hooks/shared/evidence/), so a
replay reproduces what hooks/write_checks.py noted. Uses: checking a HANDOFF before accepting
it, replaying past HANDOFFs, debugging the check. It asks no model and makes no network call.
When the task file is gone (a finished team), the session journal's latest agent_handoff for
the task stands in.
Exit codes: 0 nothing flagged; 1 at least one flag; 2 usage error; 4 task not found.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))
from shared import evidence as ev  # noqa: E402


def load(args) -> tuple[dict | None, str | None]:
    if args.task_json:
        path = Path(args.task_json).expanduser()
        team = args.team or path.parent.name
    elif args.team and args.task:
        path, team = ev.task_path(args.team, args.task), args.team
    else:
        return None, None
    return ev.load_task(path), team


def render(verdict: dict) -> str:
    head = f"#{verdict['task_id']} {verdict['kind']} team={verdict.get('team')} mode={verdict.get('mode')}"
    if verdict.get("stop"):
        return f"{head}\nstop: {verdict['stop']}"
    lines = [f"{head} ledger={verdict.get('ledger')} runs_in_scope={verdict.get('runs_in_scope')}"]
    for item in verdict["items"]:
        mark = "FLAG" if item["flag"] else "    "
        lines.append(f"{mark} {item['field']}[{item['idx']}] {item['run_check']}  {item['text'][:90]}")
    message = ev.flag_message(verdict)
    lines.append(message or f"flagged=0 of {len(verdict['items'])} item(s)")
    return "\n".join(lines)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="handoff-evidence", formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Check a HANDOFF's claims against the run ledger. Advisory only: it never "
                    "changes the task.",
        epilog="examples:\n"
               "  handoff-evidence handoff --team session-5a318e14 --task 38\n"
               "  handoff-evidence handoff ~/.claude/tasks/session-5a318e14/38.json --show\n"
               "exit: 0 no flag, 1 flagged, 2 usage, 4 task not found.")
    parser.add_argument("kind", choices=("handoff",))
    parser.add_argument("task_json", nargs="?", help="path to a task JSON file")
    parser.add_argument("--team", help="team name (with --task)")
    parser.add_argument("--task", help="task id (with --team)")
    parser.add_argument("--show", action="store_true", help="print the verdict JSON")
    parser.add_argument("--cwd", help="the writer's working tree, to scope ledger runs")
    parser.add_argument("--branch", help="the writer's git branch, to scope ledger runs")
    parser.add_argument("--session", help="the writer's session id (default: the team lead's), to own "
                        "unattributed ledger runs")
    parser.add_argument("--ledger", help="ledger file (default: the plugin data dir's)")
    args = parser.parse_args(sys.argv[1:] if argv is None else argv)
    if not args.task_json and not (args.team and args.task):
        parser.error("give a task JSON path, or --team and --task")
    task, team = load(args)
    if task is None and args.task and team:
        task = ev.task_from_journal(team, args.task)
        if task is not None:
            print(f"note: task file gone; using the session journal's latest agent_handoff for #{args.task}",
                  file=sys.stderr)
    if task is None:
        print("handoff-evidence: task not found or unreadable", file=sys.stderr)
        return 4
    verdict = ev.evaluate_handoff(task, team, cwd=args.cwd, branch=args.branch,
                                  ledger=args.ledger, session_id=args.session)
    print(json.dumps(verdict, ensure_ascii=False, indent=1) if args.show else render(verdict))
    return 1 if verdict.get("flagged") else 0


if __name__ == "__main__":
    sys.exit(main())
