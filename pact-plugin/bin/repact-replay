#!/usr/bin/env python3
"""repact-replay: run the hooks of two plugin trees over one corpus of hook input frames and
print what differs.

Location: pact-plugin/bin/repact-replay. The engine lives in bin/_replay.py.

  repact-replay corpus [--out DIR] [--config-dir DIR] [--data-dir DIR]
      Build the corpus: frames rebuilt from the task directories and task-files-backup
      directories of the config dir, from the background_stop_gate rows of the session
      journals and from the run ledger, plus a built-in set of odd frames and turn-end
      scenarios. The corpus holds real commands and task text: it is written with mode 700,
      by default to ${CLAUDE_PLUGIN_DATA}/replay-corpus, never inside a git checkout, and only
      its counts are printed. Reads task files, session journals and the run ledger, nothing
      else.

  repact-replay run --a TREE --b TREE [--corpus DIR] [--event E] [--level both|hook|event]
                    [--every N] [--shard K/N] [--frame ID ...] [--skip HOOK ...] [--no-sandbox]
      For every frame and each tree (a plugin root, or a checkout of the repository), run the
      hooks that tree's hooks.json registers for the frame's event and matcher, in order, each
      as its own process in a fresh temporary root seeded with the frame's state. Nothing a
      hook does can land in the live config dir, the plugin data dir or a repository: see
      bin/_replay.py for the layers, and the `enforcement:` line for whether the kernel
      sandbox was one of them.
      Compared per hook: exit code, every field of its JSON output, whether stderr holds a
      traceback. Compared per event: any deny or block, the reasons, the concatenated context,
      the files written and the journal rows appended, so a tree with one dispatcher entry
      compares with a tree with fifteen (`--level event` drops the per-hook rows).
      One row per difference: frame id, event, hook or "event", field, a, b (values cut to 80
      characters, never a frame's content), then the counts per event and per hook.
      A frame in which a hook ran past the harness timeout (30 s; a starved CPU) runs again; if
      one still does, the frame's only row is `event timeout <hooks of a> <hooks of b>`, never a
      decision row (a killed hook prints nothing, which read as an allow).
      --every N takes every Nth frame; --shard K/N the Kth of N slices of those.

Exit codes: 0 nothing differs (or the corpus was built), 1 at least one difference, 64 usage.

Examples
  python3 "${CLAUDE_PLUGIN_ROOT}/bin/repact-replay" corpus
  nice -n 19 python3 "${CLAUDE_PLUGIN_ROOT}/bin/repact-replay" run --a ../v1 --b . --event Stop
"""
from __future__ import annotations

import argparse
import signal
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _replay  # noqa: E402

EXIT_SAME, EXIT_DIFFERENT, EXIT_USAGE = 0, 1, 64


class _Parser(argparse.ArgumentParser):
    def error(self, message):
        print(f"repact-replay: {message}\n\n"
              'example: python3 "${CLAUDE_PLUGIN_ROOT}/bin/repact-replay" run --a OLD --b NEW',
              file=sys.stderr)
        sys.exit(EXIT_USAGE)


def _shard(text: str) -> tuple[int, int]:
    try:
        k, n = (int(part) for part in text.split("/"))
    except ValueError:
        raise argparse.ArgumentTypeError("write K/N, for example 1/4") from None
    if not 1 <= k <= n:
        raise argparse.ArgumentTypeError("K/N needs 1 <= K <= N")
    return k, n


def _positive(text: str) -> int:
    try:
        value = int(text)
    except ValueError:
        value = 0
    if value < 1:
        raise argparse.ArgumentTypeError("a whole number from 1")
    return value


def main(argv: list[str]) -> int:
    parser = _Parser(prog="repact-replay", formatter_class=argparse.RawDescriptionHelpFormatter,
                     description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True, parser_class=_Parser)
    corpus = commands.add_parser("corpus")
    corpus.add_argument("--out", type=Path)
    corpus.add_argument("--config-dir", type=Path)
    corpus.add_argument("--data-dir", type=Path)
    run = commands.add_parser("run")
    run.add_argument("--a", type=Path, required=True)
    run.add_argument("--b", type=Path, required=True)
    run.add_argument("--corpus", type=Path)
    run.add_argument("--event")
    run.add_argument("--level", choices=("both", "hook", "event"), default="both")
    run.add_argument("--every", type=_positive, default=1)
    run.add_argument("--shard", type=_shard, default=(1, 1))
    run.add_argument("--frame", action="append", default=[])
    run.add_argument("--skip", action="append", default=[])
    run.add_argument("--jobs", type=_positive, default=_replay.MAX_WORKERS)
    run.add_argument("--no-sandbox", action="store_true")
    args = parser.parse_args(argv)

    try:
        if args.command == "corpus":
            data_dir = args.data_dir or _replay.default_data_dir()
            out = args.out or data_dir / "replay-corpus"
            manifest = _replay.build_corpus(
                out, args.config_dir or _replay.default_config_dir(), data_dir)
            frames = manifest["frames"]
            print(f"corpus: {sum(frames.values())} frames, {manifest['states']} states, in {out}")
            print("by source: " + ", ".join(f"{k} {v}" for k, v in frames.items()))
            return EXIT_SAME
        corpus_dir = args.corpus or _replay.default_data_dir() / "replay-corpus"
        # A stop request unwinds the run, so its temporary root is removed.
        signal.signal(signal.SIGTERM, lambda _signum, _frame: sys.exit(143))
        with _replay.Replay(args.a, args.b, corpus_dir, sandbox=not args.no_sandbox,
                            skip=tuple(args.skip), level=args.level) as replay:
            records = replay.frames(args.event, args.every, args.shard, tuple(args.frame))
            rows, frames = replay.run(
                records, args.jobs,
                progress=lambda done: print(f"... {done} frames", file=sys.stderr, flush=True))
            _replay.report(rows, frames, replay)
        return EXIT_DIFFERENT if rows else EXIT_SAME
    except _replay.ReplayError as error:
        parser.error(str(error))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
