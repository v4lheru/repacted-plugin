#!/usr/bin/env python3
"""repact-report: the session's measured tables.

Location: pact-plugin/bin/repact-report. Read-only, on demand; `repact report`
dispatches here. About 20 lines for the current (or named) session: spend by role, idle-only
and double wakes, lead->teammate delivery delays, rejections by cause, the amendment gate's
log, process-table guard denials, task-list reminders, UNFLAGGED alarms, the write-time checks' returns,
repeats, notes and noted writes per check, and the context cost from the session dir: bytes the
hooks injected (context-cost.json, top 5 checks) and bytes of teachback and handoff writes
per agent (metadata_write journal rows);
--cost-all sums every session of the project. Definitions follow
the design notes section 1 (see bin/_transcripts.py). Counts only.

Usage: repact-report [--transcript PATH | --session ID] [--team NAME] [--until ISO] [--cost-all] [--json]
Exit codes: 0 printed; 2 usage error; 3 no session transcript found.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))   # bin -> shared, the allowed direction
from shared import transcripts as tr  # noqa: E402

EXAMPLE = "repact-report --json --until 2026-09-26T22:15:00Z"


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="repact-report", description=__doc__.split("\n")[0],
                                     epilog=f"example: {EXAMPLE}")
    parser.add_argument("--transcript", help="the lead transcript (.jsonl)")
    parser.add_argument("--session", help="the lead session id")
    parser.add_argument("--team", help="the team name (default: from the teammates' metadata)")
    parser.add_argument("--until", help="replay: read only entries at or before this ISO time")
    parser.add_argument("--cost-all", action="store_true",
                        help="context cost over every session journal of the project, not just this one")
    parser.add_argument("--json", action="store_true", help="machine output")
    args = parser.parse_args(argv)
    until = tr.parse_ts(args.until) if args.until else None
    if args.until and until is None:
        parser.error(f"--until is not an ISO time: {args.until!r}")
    lead = tr.find_lead_transcript(args.transcript, args.session)
    if lead is None:
        print("repact-report: no session transcript found (give --transcript or --session)", file=sys.stderr)
        return 3
    report = tr.build_report(lead, until=until, team=args.team, cost_all=args.cost_all)
    print(json.dumps(report, indent=1, sort_keys=True) if args.json else "\n".join(tr.render_report(report)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
