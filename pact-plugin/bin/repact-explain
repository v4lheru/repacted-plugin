#!/usr/bin/env python3
"""repact-explain: what the last refusals were and why, from the session journal.
Location: pact-plugin/bin/repact-explain. Read-only, on demand. Prints one block per
gate_refusal or check_failure row: when, hook, verdict, rule, the fixed sentence for the rule
(hooks/shared/rules.py), the way through (`instead`), target and frame, and the troubleshooting
anchor (docs/troubleshooting.md#<id>). No new store: the journal rows
carry hashes, never command text or reasons, so this shows the id and its sentence, not the
refused command.
Usage: repact-explain [last | <code>] [--last] [--n N] [--frame lead|teammate] [--agent NAME]
                      [--hook NAME] [--session ID | --session-dir PATH]
  last, --last  the most recent row (the default is the last 5)
  <code>      rows whose `code` (sha256[:12] of the reason) starts with this prefix
The session is $CLAUDE_CODE_SESSION_ID unless --session or --session-dir names another.
Exit codes: 0 printed; 1 no matching row; 2 usage error; 3 no journal found.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))
import _repact_common as common  # noqa: E402
from shared.evidence import ledger as ev  # noqa: E402

EXAMPLE = "repact-explain --last"
ROW_TYPES = ("gate_refusal", "check_failure")


def _rules():
    hooks = str(common.plugin_root() / "hooks")
    if hooks not in sys.path:
        sys.path.insert(0, hooks)
    from shared.rules import explain
    return explain


def journal_path(session: str | None, session_dir: str | None) -> Path | None:
    if session_dir:
        path = Path(session_dir).expanduser() / "session-journal.jsonl"
        return path if path.is_file() else None
    session_id = session or os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    return ev.session_journal(session_id) if session_id else None


def read_rows(path: Path) -> list[dict]:
    rows = []
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return rows
    for line in lines:
        try:
            row = json.loads(line)
        except ValueError:
            continue
        if isinstance(row, dict) and row.get("type") in ROW_TYPES:
            rows.append(row)
    return rows


def select(rows: list[dict], code: str | None, last: bool, n: int,
           frame: str | None, hook: str | None, agent: str | None = None) -> list[dict]:
    chosen = rows
    if code:
        chosen = [r for r in chosen if str(r.get("code", "")).startswith(code)]
    if frame:
        chosen = [r for r in chosen if r.get("frame") == frame]
    if agent:
        chosen = [r for r in chosen if r.get("agent") == agent]
    if hook:
        chosen = [r for r in chosen if (r.get("hook") or r.get("check")) == hook]
    return chosen[-1:] if last else chosen[-n:]


def render(row: dict, explain) -> list[str]:
    when = row.get("ts") or row.get("timestamp") or row.get("time") or ""
    hook = row.get("hook") or row.get("check") or ""
    if row.get("type") == "check_failure":
        return [f"{when}  {hook}  failed  {row.get('exc_class', '')}",
                "  the check raised, timed out or could not load; the dispatcher went on "
                "(a security check's timeout is journaled as a gate_refusal too)."]
    rule_id = str(row.get("rule", ""))
    rule = explain(rule_id)
    lines = [f"{when}  {hook}  {row.get('verdict', '')}  {rule_id}"]
    lines.append(f"  {rule.explain}" if rule else
                 f"  (no sentence on file for {rule_id}: a check that names no rule id; the "
                 f"channel was {row.get('channel') or rule_id.rsplit('.', 1)[-1]})")
    detail = [f"code {row.get('code', '')}", f"target {row.get('target', '') or '-'}",
              f"frame {row.get('frame', '') or '-'}", f"event {row.get('event', '') or '-'}"]
    if row.get("agent"):
        detail.append(f"agent {row['agent']}")
    if row.get("tool_name"):
        detail.append(f"tool {row['tool_name']}")
    if rule:
        lines.append(f"  instead: {rule.instead}")
    lines.append("  " + "  ".join(detail))
    if rule:
        lines.append(f"  doc {rule.doc}")
    return lines


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="repact-explain", description=__doc__.split("\n")[0],
                                     epilog=f"example: {EXAMPLE}")
    parser.add_argument("what", nargs="?", help="'last', or a code prefix (default: the last --n)")
    parser.add_argument("--last", action="store_true", help="the most recent row only (as 'last')")
    parser.add_argument("--n", type=int, default=5, help="rows to show (default 5)")
    parser.add_argument("--frame", choices=("lead", "teammate"))
    parser.add_argument("--agent", help="only rows the named actor earned (as journaled)")
    parser.add_argument("--hook", help="only rows of this check")
    parser.add_argument("--session", help="the session id (default: $CLAUDE_CODE_SESSION_ID)")
    parser.add_argument("--session-dir", help="the session directory holding session-journal.jsonl")
    parser.add_argument("--json", action="store_true", help="machine output (the rows)")
    args = parser.parse_args(argv)
    if args.n < 1:
        parser.error("--n must be at least 1")
    last = args.last or args.what == "last"
    code = None if args.what == "last" or not args.what else args.what
    if code and not all(ch in "0123456789abcdef" for ch in code):
        parser.error(f"not a code prefix: {code!r}")
    path = journal_path(args.session, args.session_dir)
    if path is None:
        print("repact-explain: no session journal found (give --session or --session-dir)",
              file=sys.stderr)
        return 3
    rows = select(read_rows(path), code, last, args.n, args.frame, args.hook, args.agent)
    if not rows:
        print("repact-explain: no refusal or check failure matches", file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(rows, indent=1, sort_keys=True))
        return 0
    explain = _rules()
    print("\n".join(line for row in rows for line in render(row, explain)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
