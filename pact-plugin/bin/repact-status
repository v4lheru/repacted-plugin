#!/usr/bin/env python3
"""repact-status: one line per teammate, read from its transcript.

Location: pact-plugin/bin/repact-status. Read-only, on demand.
For each member of the session's team that has a transcript it prints
    name  busy|idle  <last tool> ["<its description>"] <age>  ctx <k>  #<in_progress ids>  bg:<n>  amend:<n>
busy means a tool call is still running, the last message did not end its turn, or a message
woke it after its last turn; bg is background jobs launched and not yet reported finished;
amend is amend_<n> keys on its in_progress tasks the relay has not handed it yet.
It never prints tool inputs or outputs: only the description an agent writes for a call,
with secret values redacted.

Usage: repact-status [--transcript PATH | --session ID] [--team NAME] [--until ISO]
Exit codes: 0 printed; 2 usage error; 3 no session transcript found.
"""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))   # bin -> shared, the allowed direction
from shared import transcripts as tr  # noqa: E402

EXAMPLE = "repact-status --session 5a318e14-c851-4a08-a12d-e779a43d3ec8"


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="repact-status", description=__doc__.split("\n")[0],
                                     epilog=f"example: {EXAMPLE}")
    parser.add_argument("--transcript", help="the lead transcript (.jsonl)")
    parser.add_argument("--session", help="the lead session id")
    parser.add_argument("--team", help="the team name (default: from the teammates' metadata)")
    parser.add_argument("--until", help="replay: read only entries at or before this ISO time")
    args = parser.parse_args(argv)
    until = tr.parse_ts(args.until) if args.until else None
    if args.until and until is None:
        parser.error(f"--until is not an ISO time: {args.until!r}")
    lead = tr.find_lead_transcript(args.transcript, args.session)
    if lead is None:
        print("repact-status: no session transcript found (give --transcript or --session)", file=sys.stderr)
        return 3
    lines = tr.status_lines(lead, team=args.team, until=until)
    print("\n".join(lines) if lines else "no teammate transcripts in this session")
    return 0


if __name__ == "__main__":
    sys.exit(main())
