#!/usr/bin/env python3
"""kb-find: the generic name of vault-find (KB search); same arguments, output and exit codes.

Location: pact-plugin/bin/kb-find. It replaces itself with vault-find beside it, so
there is one implementation and `kb-find --help` is `vault-find --help`.
"""
import os
import sys
from pathlib import Path

TARGET = Path(__file__).resolve().parent / "vault-find"

if __name__ == "__main__":
    os.execv(sys.executable, [sys.executable, str(TARGET), *sys.argv[1:]])
